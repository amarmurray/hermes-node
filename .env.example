# hermes-node wrapper settings. Keep upstream Hermes secrets in ~/.hermes/.env.

HERMES_NODE_UPSTREAM_HOME=~/.hermes
HERMES_NODE_UPSTREAM_REPO=~/apps/hermes-agent
HERMES_NODE_HERMES_BIN=~/.local/bin/hermes

HERMES_NODE_DB_PATH=state/hermes-node.db
HERMES_NODE_LOG_JSONL=logs/hermes-node.jsonl

HERMES_NODE_SERVICE_USER=ubuntu

# Default upstream execution path for read-only wrapper tasks.
HERMES_NODE_DEFAULT_PROVIDER=openrouter
HERMES_NODE_DEFAULT_MODEL=openai/gpt-oss-20b:free
HERMES_NODE_DEFAULT_MAX_TURNS=4
HERMES_NODE_POLL_INTERVAL_SECONDS=15
HERMES_NODE_SOURCE_TAG=tool

# Retry/backoff for rate-limited tasks (429s).
HERMES_NODE_MAX_ATTEMPTS=5
HERMES_NODE_BASE_BACKOFF_SECONDS=30
HERMES_NODE_MAX_BACKOFF_SECONDS=900

# Optional Codex-native auth for repo_read / repo_patch_branch.
# If omitted, hermes-node can still use OPENROUTER_API_KEY from ~/.hermes/.env.
# OPENAI_API_KEY=sk-...
