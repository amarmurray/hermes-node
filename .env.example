# Wrapper repo settings. These are distinct from the upstream ~/.hermes/.env file.

HERMES_NODE_UPSTREAM_HOME=~/.hermes
HERMES_NODE_UPSTREAM_REPO=~/.hermes/hermes-agent
HERMES_NODE_HERMES_BIN=~/.local/bin/hermes
HERMES_NODE_LOG_JSONL=logs/hermes-node.jsonl

# Install spec passed to the upstream repo during bootstrap.
# Use "." for the thinnest CLI-only install.
HERMES_NODE_UPSTREAM_INSTALL_SPEC=.[messaging]
HERMES_NODE_UPSTREAM_REF=main

# Service defaults for wrapper helpers.
HERMES_NODE_SYSTEMD_SCOPE=user
HERMES_NODE_SERVICE_USER=ubuntu

# Local-only upstream API server defaults.
HERMES_NODE_ENABLE_API_SERVER=true
HERMES_NODE_API_BASE_URL=http://127.0.0.1:8642/v1
HERMES_NODE_API_KEY=change-me-local-dev

# Optional defaults for one-shot submit helpers.
HERMES_NODE_DEFAULT_PROVIDER=
HERMES_NODE_DEFAULT_MODEL=
