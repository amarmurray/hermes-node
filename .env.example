# hermes-node wrapper settings. Keep upstream Hermes secrets in ~/.hermes/.env.

HERMES_NODE_UPSTREAM_HOME=~/.hermes
HERMES_NODE_UPSTREAM_REPO=~/apps/hermes-agent
HERMES_NODE_HERMES_BIN=~/.local/bin/hermes

HERMES_NODE_DB_PATH=state/hermes-node.db
HERMES_NODE_LOG_JSONL=logs/hermes-node.jsonl

HERMES_NODE_SERVICE_USER=ubuntu

# Default upstream execution path for read-only wrapper tasks.
HERMES_NODE_DEFAULT_PROVIDER=openrouter
HERMES_NODE_DEFAULT_MODEL=openai/gpt-oss-20b:free
HERMES_NODE_DEFAULT_MAX_TURNS=4
HERMES_NODE_POLL_INTERVAL_SECONDS=15
HERMES_NODE_SOURCE_TAG=tool

# Retry/backoff for rate-limited tasks (429s).
HERMES_NODE_MAX_ATTEMPTS=5
HERMES_NODE_BASE_BACKOFF_SECONDS=30
HERMES_NODE_MAX_BACKOFF_SECONDS=900

# Optional Codex-native auth for repo_read / repo_patch_branch.
# If omitted, hermes-node can still use OPENROUTER_API_KEY from ~/.hermes/.env.
# OPENAI_API_KEY=sk-...

# Operator LLM backend (local inference server).
# Default: Ollama at localhost:11434 with qwen3:1.7b.
# HERMES_OPERATOR_BASE_URL=http://localhost:11434
# HERMES_OPERATOR_MODEL=qwen3:1.7b
# HERMES_OPERATOR_API_KEY=
# HERMES_OPERATOR_REMOTE_PROVIDER=openrouter
# HERMES_OPERATOR_REMOTE_BASE_URL=
# HERMES_OPERATOR_REMOTE_MODEL=
# HERMES_OPERATOR_REMOTE_API_KEY=
# HERMES_OPERATOR_FALLBACK_PROVIDER=ollama
# HERMES_OPERATOR_FALLBACK_BASE_URL=
# HERMES_OPERATOR_FALLBACK_MODEL=
# HERMES_OPERATOR_FALLBACK_API_KEY=

# Operator Telegram ingress (thin wedge; reuses operator backend/tools/session).
# Create a bot via @BotFather, then set the token below.
# Allowlist is a comma-separated list of Telegram chat IDs. Bot refuses all
# updates until at least one chat_id is listed. Tip: message the bot once,
# then inspect logs/hermes-node.jsonl for the update_denied entry to find it.
# HERMES_OPERATOR_TELEGRAM_TOKEN=
# HERMES_OPERATOR_TELEGRAM_ALLOWED_CHAT_IDS=
# HERMES_OPERATOR_TELEGRAM_POLL_TIMEOUT=30
# HERMES_OPERATOR_TELEGRAM_ALERT_POLL_SECONDS=60
